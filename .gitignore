# dependencies
node_modules/
.pnpm-store/

# builds
dist/
build/
.next*/
out/
generated/
*.tsbuildinfo

# turbo
.turbo/

# env & secrets — NEVER commit
.env
.env.*
!.env.example
*.pem
*.key
!packages/db/prisma/**/*.sql
secrets/
*.lic

# generated service worker (built by @serwist/next; never hand-edited)
apps/web/public/sw.js
apps/web/public/sw.js.map
apps/web/public/swe-worker-*.js

# test output
apps/web/lighthouse-report/
.lighthouseci/
coverage/
playwright-report/
test-results/
# Handoff written by apps/web/e2e/stack.mts at run time (origins + hospital id).
# Untracked but unignored, it dirtied the tree after every e2e run and CI's
# `prettier --check` glob picked it up.
apps/web/e2e/.stack.json
# `.next*/` above already covers the browser suite's `.next-e2e` (D-50) and any
# other dist directory a dev server is pointed at.
blob-report/
.nyc_output/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.recommended.json

# local infra volumes
infra/docker/volumes/
.gstack/
