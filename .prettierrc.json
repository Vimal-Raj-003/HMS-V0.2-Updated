{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 110,
  "tabWidth": 2,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.md"],
      "options": { "printWidth": 120, "proseWrap": "preserve" }
    },
    {
      "files": ["*.prisma"],
      "options": { "printWidth": 120 }
    }
  ]
}
