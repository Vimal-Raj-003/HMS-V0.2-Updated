{
  "name": "@vims/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, hand-written RLS/partition/index SQL, Kysely types and idempotent seeds for PostgreSQL 17.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tenancy": {
      "development": "./src/tenancy.ts",
      "types": "./dist/tenancy.d.ts",
      "import": "./dist/tenancy.js",
      "default": "./dist/tenancy.js"
    },
    "./seed": {
      "development": "./src/seed/run.ts",
      "types": "./dist/seed/run.d.ts",
      "import": "./dist/seed/run.js",
      "default": "./dist/seed/run.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "lint": "eslint src --max-warnings=0 --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:status": "dotenv -e ../../.env -- prisma migrate status",
    "reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "seed": "pnpm seed:minimal",
    "seed:minimal": "dotenv -e ../../.env -- node --conditions=development --import tsx src/seed/run.ts --tier=minimal",
    "seed:demo": "dotenv -e ../../.env -- node --conditions=development --import tsx src/seed/run.ts --tier=demo",
    "seed:hospital": "dotenv -e ../../.env -- node --conditions=development --import tsx src/seed/run.ts --tier=hospital",
    "seed:volume": "dotenv -e ../../.env -- node --conditions=development --import tsx src/seed/run.ts --tier=volume"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@vims/contracts": "workspace:*",
    "argon2": "^0.45.1",
    "kysely": "^0.29.5",
    "pg": "^8.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "dotenv-cli": "^8.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.19.2",
    "vitest": "^4.1.10"
  }
}
