// ─────────────────────────────────────────────────────────────────────────────
// NC-006 §4 — stores, batches and the stock ledger (schema `inventory`)
//
// This file holds the one table the whole phase is built around.
//
// ── `inventory.stock_ledger` is append-only, and that is enforced ───────────
//
// `phase-04 §Constraints`: "**The stock ledger never gets an UPDATE.**
// Corrections are new compensating entries with reason. Any code that mutates a
// ledger row fails review." Review is not a mechanism. Three are:
//
//   1. `inventory.enforce_ledger_append_only()` — a BEFORE UPDATE OR DELETE
//      trigger that raises unconditionally, on the parent and on every
//      partition, present and future.
//   2. `REVOKE UPDATE, DELETE ... FROM hms_app` — so a dropped trigger is not
//      enough on its own, and the partition helper the worker calls is the
//      append-only one that never grants UPDATE.
//   3. `stock_balances` is maintained by an AFTER INSERT trigger on the ledger
//      and by nothing else, so `sum(qty_base) == qty_on_hand` holds by
//      construction rather than by a nightly job that notices it has stopped.
//
// A correction is `movement_type = 'correction'` naming `corrects_ledger_id`
// and carrying a reason. The original row stays; that is the point.
//
// ── Every quantity is signed, and in base units ─────────────────────────────
//
// `qty_base` is positive for anything entering the store and negative for
// anything leaving it, so the balance of a store/item/batch is a plain
// `sum()`. `movement_type` says what happened; `direction` is derived from the
// sign and checked against the type, so a GRN cannot be stored as a negative
// number and an issue cannot be stored as a positive one.
//
// ── Valuation ───────────────────────────────────────────────────────────────
//
// Both methods NC-006 §3 offers are supported and the choice is per store, not
// per hospital: a pharmacy on weighted average and a main store on FIFO is an
// ordinary arrangement. `fifo_layers` exists only for the FIFO stores;
// `stock_balances.avg_cost` carries the weighted average for the others, and
// the ledger records `unit_cost` and `value` on every row either way so a
// valuation is reproducible from the ledger alone.
// ─────────────────────────────────────────────────────────────────────────────

enum InvStoreType {
  main
  pharmacy
  ward
  icu
  ot
  er
  lab
  radiology
  cssd
  dialysis
  blood_bank
  kitchen
  housekeeping
  engineering
  it
  ambulance
  /// Stock held on a vendor's behalf. Never valued as ours (NC-007).
  consignment
  /// Where a failed QC, a recall or an excursion puts stock.
  quarantine
  /// Where expired stock waits for disposal under BMW rules.
  expired_hold
  other

  @@schema("inventory")
}

/// What a store does when a movement would take a balance below zero.
/// `block` is the default and the only safe one for a dispensing counter:
/// `phase-04 §Constraints` — "never dispense without a successful batch
/// validation — fail closed on stock integrity".
enum InvNegativeStockPolicy {
  block
  allow_with_approval

  @@schema("inventory")
}

enum InvValuationMethod {
  weighted_average
  fifo

  @@schema("inventory")
}

enum InvBatchStatus {
  active
  quarantined
  recalled
  expired
  exhausted
  returned_to_vendor
  written_off

  @@schema("inventory")
}

enum InvSerialStatus {
  in_stock
  reserved
  issued
  used
  returned
  scrapped
  returned_to_vendor

  @@schema("inventory")
}

/// Every reason a quantity moves. The list is closed on purpose: an
/// unclassifiable movement is an adjustment with a reason code, never a new
/// verb somebody adds to a service.
enum InvMovementType {
  /// Positive
  opening
  grn
  purchase_free
  transfer_in
  issue_in
  return_in
  patient_return
  consignment_in
  repack_in
  adjustment_plus
  count_gain
  /// Negative
  issue_out
  transfer_out
  dispense
  consumption
  sale
  vendor_return
  expiry_writeoff
  damage_writeoff
  wastage
  consignment_used
  consignment_return
  repack_out
  adjustment_minus
  count_loss
  /// Either sign — the compensating entry for a mistaken ledger row.
  correction

  @@schema("inventory")
}

/// What document caused the movement. Together with `ref_id` this is how a
/// quantity is traced back to a person and a piece of paper.
enum InvRefType {
  opening
  grn
  purchase_return
  store_indent
  issue
  transfer
  dispense
  sale_return
  consumption
  adjustment
  count
  writeoff
  quarantine
  recall
  consignment_receipt
  consignment_usage
  consignment_return
  repack
  correction

  @@schema("inventory")
}

model InvStore {
  id            String  @id @db.Uuid
  hospitalId    String  @map("hospital_id") @db.Uuid
  branchId      String  @map("branch_id") @db.Uuid
  code          String  @db.VarChar(32)
  name          String  @db.VarChar(200)
  storeType     InvStoreType @map("store_type")
  /// The store this one draws from. A ward store's parent is the pharmacy;
  /// the pharmacy's is the main store. `inventory.enforce_store_tree()` refuses
  /// a cycle.
  parentStoreId String? @map("parent_store_id") @db.Uuid
  custodianUserId String? @map("custodian_user_id") @db.Uuid
  departmentKey String? @map("department_key") @db.Uuid
  costCentreId  String? @map("cost_centre_id") @db.Uuid
  /// Drug licence for the premises. Without a valid one this store may not
  /// hold a scheduled drug — the GRN and transfer-in checks read it.
  drugLicenceNo String? @map("drug_licence_no") @db.VarChar(64)
  drugLicenceExpiry DateTime? @map("drug_licence_expiry") @db.Date
  /// Restricts what may be stocked here. Empty = anything.
  allowedCategoryIds String[] @default([]) @map("allowed_category_ids") @db.Uuid
  negativeStockPolicy InvNegativeStockPolicy @default(block) @map("negative_stock_policy")
  valuationMethod InvValuationMethod @default(weighted_average) @map("valuation_method")
  isConsignment Boolean @default(false) @map("is_consignment")
  /// Narcotics are stored and reconciled separately (`phase-04 §4.2`); a store
  /// without this flag cannot receive an NDPS item at all.
  holdsNarcotics Boolean @default(false) @map("holds_narcotics")
  /// The counter is open outside the store's own hours (24×7 pharmacy).
  is24x7        Boolean @default(false) @map("is_24x7")
  active        Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  version   Int      @default(0)

  parent    InvStore?  @relation("InvStoreTree", fields: [parentStoreId], references: [id], onDelete: Restrict)
  children  InvStore[] @relation("InvStoreTree")
  locations InvStoreLocation[]
  tempZones InvTempZone[]

  @@unique([hospitalId, code])
  @@index([hospitalId, branchId, active])
  @@index([hospitalId, storeType, active])
  @@index([hospitalId, parentStoreId])
  @@map("stores")
  @@schema("inventory")
}

/// Rack / shelf / bin. `path` is an ltree in the migration so a pick list can
/// be walked in physical order.
model InvStoreLocation {
  id          String  @id @db.Uuid
  hospitalId  String  @map("hospital_id") @db.Uuid
  storeId     String  @map("store_id") @db.Uuid
  code        String  @db.VarChar(48)
  name        String? @db.VarChar(160)
  path        String  @db.VarChar(512)
  tempZoneId  String? @map("temp_zone_id") @db.Uuid
  capacity    Decimal? @db.Decimal(18, 4)
  isQuarantine Boolean @default(false) @map("is_quarantine")
  isExpiredHold Boolean @default(false) @map("is_expired_hold")
  /// The controlled-substance safe. NDPS stock may live nowhere else.
  isControlledSafe Boolean @default(false) @map("is_controlled_safe")
  barcode     String? @db.VarChar(64)
  active      Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  store InvStore @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([storeId, code])
  @@index([hospitalId, storeId, active])
  @@map("store_locations")
  @@schema("inventory")
}

/// A monitored temperature zone (a fridge, a cold room, a vaccine carrier).
model InvTempZone {
  id          String  @id @db.Uuid
  hospitalId  String  @map("hospital_id") @db.Uuid
  storeId     String  @map("store_id") @db.Uuid
  code        String  @db.VarChar(32)
  name        String  @db.VarChar(160)
  minC        Decimal @map("min_c") @db.Decimal(6, 2)
  maxC        Decimal @map("max_c") @db.Decimal(6, 2)
  /// → EN-042 device gateway, when a sensor reports rather than a person.
  sensorDeviceId String? @map("sensor_device_id") @db.Uuid
  lastReadingC Decimal? @map("last_reading_c") @db.Decimal(6, 2)
  lastReadingAt DateTime? @map("last_reading_at") @db.Timestamptz(6)
  status      String  @default("ok") @db.VarChar(16)
  active      Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  store    InvStore @relation(fields: [storeId], references: [id], onDelete: Restrict)
  readings InvTempReading[]

  @@unique([storeId, code])
  @@index([hospitalId, storeId, active])
  @@map("temp_zones")
  @@schema("inventory")
}

/// **Partitioned monthly on `recorded_at`.** NC-006 §4 specifies it, and a
/// sensor reporting every five minutes writes ~105 000 rows per zone per year.
model InvTempReading {
  id          String  @db.Uuid
  hospitalId  String  @map("hospital_id") @db.Uuid
  zoneId      String  @map("zone_id") @db.Uuid
  valueC      Decimal @map("value_c") @db.Decimal(6, 2)
  humidityPct Decimal? @map("humidity_pct") @db.Decimal(5, 2)
  source      String  @default("sensor") @db.VarChar(16)
  /// Set by trigger against the zone's own bounds, so an excursion cannot be
  /// missed because a service forgot to compare.
  isExcursion Boolean @default(false) @map("is_excursion")
  recordedBy  String? @map("recorded_by") @db.Uuid
  recordedAt  DateTime @map("recorded_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  zone InvTempZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  @@id([id, recordedAt])
  @@index([hospitalId, zoneId, recordedAt])
  @@index([hospitalId, isExcursion, recordedAt])
  @@map("temp_readings")
  @@schema("inventory")
}

/// A period outside the zone's bounds, and what was decided about the stock
/// that was in it. Undecided is a real state and it blocks issue.
model InvTempExcursion {
  id          String  @id @db.Uuid
  hospitalId  String  @map("hospital_id") @db.Uuid
  zoneId      String  @map("zone_id") @db.Uuid
  startedAt   DateTime @map("started_at") @db.Timestamptz(6)
  endedAt     DateTime? @map("ended_at") @db.Timestamptz(6)
  minC        Decimal? @map("min_c") @db.Decimal(6, 2)
  maxC        Decimal? @map("max_c") @db.Decimal(6, 2)
  durationMinutes Int? @map("duration_minutes")
  affectedBatchIds String[] @default([]) @map("affected_batch_ids") @db.Uuid
  decision    String  @default("pending") @db.VarChar(24)
  decidedBy   String? @map("decided_by") @db.Uuid
  decidedAt   DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote String? @map("decision_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  @@index([hospitalId, zoneId, startedAt])
  @@index([hospitalId, decision])
  @@map("temp_excursions")
  @@schema("inventory")
}

/// The batch — the unit a recall, an expiry and a traceability question all
/// address. Hospital-wide, not per store: the same batch sits in four stores
/// and a recall must reach all of them from one row.
model InvItemBatch {
  id            String  @id @db.Uuid
  hospitalId    String  @map("hospital_id") @db.Uuid
  itemId        String  @map("item_id") @db.Uuid
  batchNo       String  @map("batch_no") @db.VarChar(64)
  mfgDate       DateTime? @map("mfg_date") @db.Date
  /// Null only for items whose `tracking` is `none` or `serial`. A trigger
  /// enforces that: `batch_expiry` tracking without an expiry is how an expired
  /// pack gets dispensed.
  expiryDate    DateTime? @map("expiry_date") @db.Date
  /// Printed on the pack. Checked against the DPCO ceiling in force on
  /// `received_at` for a scheduled formulation.
  mrp           Decimal? @db.Decimal(14, 2)
  unitCost      Decimal? @map("unit_cost") @db.Decimal(14, 4)
  currency      String  @default("INR") @db.Char(3)
  gtin          String? @db.VarChar(20)
  manufacturerId String? @map("manufacturer_id") @db.Uuid
  vendorId      String? @map("vendor_id") @db.Uuid
  grnLineId     String? @map("grn_line_id") @db.Uuid
  coaFileId     String? @map("coa_file_id") @db.Uuid
  status        InvBatchStatus @default(active)
  quarantineReason String? @map("quarantine_reason") @db.Text
  isConsignment Boolean @default(false) @map("is_consignment")
  consignmentVendorId String? @map("consignment_vendor_id") @db.Uuid
  receivedAt    DateTime @map("received_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(0)

  item    InvItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  serials InvItemSerial[]

  @@unique([hospitalId, itemId, batchNo, vendorId])
  /// FEFO. The single most-run query in the phase: "the batches of this item in
  /// this store, soonest expiry first, that are still issuable".
  @@index([hospitalId, itemId, status, expiryDate])
  @@index([hospitalId, expiryDate, status])
  @@index([hospitalId, vendorId])
  @@index([hospitalId, gtin])
  @@map("item_batches")
  @@schema("inventory")
}

/// One physical, individually identified unit. `phase-04 §4.5`: implants carry
/// a serial and a UDI, and the patient-implant handshake in Phase 6 joins on
/// this row.
model InvItemSerial {
  id          String  @id @db.Uuid
  hospitalId  String  @map("hospital_id") @db.Uuid
  itemId      String  @map("item_id") @db.Uuid
  batchId     String  @map("batch_id") @db.Uuid
  serialNo    String  @map("serial_no") @db.VarChar(96)
  /// GS1 UDI: the device identifier (DI) plus the production identifiers.
  udiDi       String? @map("udi_di") @db.VarChar(32)
  udiFull     String? @map("udi_full") @db.VarChar(256)
  status      InvSerialStatus @default(in_stock)
  currentStoreId String? @map("current_store_id") @db.Uuid
  currentLocationId String? @map("current_location_id") @db.Uuid
  /// Set when the implant goes into a patient. The traceability handshake
  /// TR-003 reads it; `phase-04 §4.5` calls it out by name.
  patientId   String? @map("patient_id") @db.Uuid
  usageRefType String? @map("usage_ref_type") @db.VarChar(24)
  usageRefId  String? @map("usage_ref_id") @db.Uuid
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  batch InvItemBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([hospitalId, itemId, serialNo])
  @@index([hospitalId, batchId, status])
  @@index([hospitalId, currentStoreId, status])
  @@index([hospitalId, patientId])
  @@index([hospitalId, udiDi])
  @@map("item_serials")
  @@schema("inventory")
}

/// **The append-only stock ledger. Partitioned monthly on `moved_at`.**
///
/// One row per quantity that moved, ever. `docs/03 §Table rules` names it in the
/// list of tables partitioned by month, and `phase-04` exit gate 8 sizes it:
/// 2000 dispensing transactions plus 500 store movements a day, four lines each,
/// is ~3.7 M rows a year. A retention or archival DELETE over that is not a
/// maintenance window anybody would agree to; DETACH + DROP of a month is.
///
/// `moved_at` is `timestamptz(3)`, not `(6)`, for the reason D-31 records: the
/// partition key is half of the composite primary key, and a microsecond value
/// read into a JavaScript `Date` and written back matches zero rows — silently,
/// because an UPDATE affecting nothing is not an error. Nothing here is measured
/// to the microsecond; ordering inside a millisecond comes from the UUIDv7.
model InvStockLedger {
  id            String  @db.Uuid
  hospitalId    String  @map("hospital_id") @db.Uuid
  branchId      String  @map("branch_id") @db.Uuid
  storeId       String  @map("store_id") @db.Uuid
  locationId    String? @map("location_id") @db.Uuid
  itemId        String  @map("item_id") @db.Uuid
  batchId       String? @map("batch_id") @db.Uuid
  serialId      String? @map("serial_id") @db.Uuid
  movementType  InvMovementType @map("movement_type")

  /// **The quantity, in the item's base UoM, signed.** Positive in, negative
  /// out. `sum(qty_base)` over any slice is that slice's balance, with no unit
  /// arithmetic anywhere.
  qtyBase       Decimal @map("qty_base") @db.Decimal(18, 4)
  /// What the human actually typed, and in what. Kept for the audit trail and
  /// the reprint; never summed. `inventory.enforce_qty_uom()` checks that
  /// `qty_base = qty_entered * item_uoms.factor_to_base` and refuses the row if
  /// it does not — so a caller that forgets to convert gets an error, not a
  /// wrong balance.
  qtyEntered    Decimal @map("qty_entered") @db.Decimal(18, 4)
  uomId         String  @map("uom_id") @db.Uuid

  /// Cost per BASE unit at the moment of the movement, and the extended value.
  /// Both stored so a valuation is reproducible from the ledger alone.
  unitCost      Decimal? @map("unit_cost") @db.Decimal(14, 4)
  value         Decimal? @db.Decimal(14, 2)
  currency      String  @default("INR") @db.Char(3)

  refType       InvRefType @map("ref_type")
  refId         String  @map("ref_id") @db.Uuid
  refLineId     String? @map("ref_line_id") @db.Uuid
  /// The other side of a transfer or an issue, so both halves are joinable.
  counterStoreId String? @map("counter_store_id") @db.Uuid
  counterLedgerId String? @map("counter_ledger_id") @db.Uuid
  /// Set for anything consumed on a named patient — the recall trace and the
  /// per-patient consumption report both read it.
  patientId     String? @map("patient_id") @db.Uuid
  encounterId   String? @map("encounter_id") @db.Uuid
  costCentreId  String? @map("cost_centre_id") @db.Uuid
  /// Stock the hospital does not own is ledgered but never valued as ours.
  isConsignment Boolean @default(false) @map("is_consignment")

  /// **Corrections.** A mistaken row is never edited; a compensating row names
  /// it here and carries a reason. `inventory.enforce_ledger_correction()`
  /// requires both together and refuses a correction of a correction chain
  /// longer than one hop.
  correctsLedgerId String? @map("corrects_ledger_id") @db.Uuid
  reason        String? @db.Text
  remarks       String? @db.Text

  actorId       String? @map("actor_id") @db.Uuid
  /// The second authorising person, for narcotics and high-alert wastage.
  secondActorId String? @map("second_actor_id") @db.Uuid
  movedAt       DateTime @map("moved_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  @@id([id, movedAt])
  /// The balance and movement-history query: "this item, in this store, newest
  /// first". Leading `hospital_id` per docs/03.
  @@index([hospitalId, storeId, itemId, movedAt])
  /// Batch history and the FEFO cross-check.
  @@index([hospitalId, batchId, movedAt])
  /// "What did document X move" — the reconciliation join for GRN, issue,
  /// transfer, dispense and count.
  @@index([hospitalId, refType, refId])
  /// The recall trace: batch → patients dispensed (`phase-04` exit gate 5).
  /// The migration replaces this with a `WHERE patient_id IS NOT NULL` partial
  /// index — most ledger rows have no patient, and a full index would add write
  /// cost to the busiest table in the phase for rows it can never serve.
  @@index([hospitalId, patientId, movedAt])
  @@index([hospitalId, correctsLedgerId])
  @@map("stock_ledger")
  @@schema("inventory")
}

/// The projection of the ledger, maintained by trigger and by nothing else.
///
/// One row per (store, location, item, batch). Reads are constant-time, which
/// matters because the dispensing counter's 45-second budget
/// (`phase-04 §Constraints`) does not survive a `sum()` over four million rows.
/// `inventory.verify_stock_integrity()` re-derives it from the ledger and is
/// what exit gate 6 runs.
model InvStockBalance {
  id            String  @id @db.Uuid
  hospitalId    String  @map("hospital_id") @db.Uuid
  branchId      String  @map("branch_id") @db.Uuid
  storeId       String  @map("store_id") @db.Uuid
  locationId    String? @map("location_id") @db.Uuid
  itemId        String  @map("item_id") @db.Uuid
  batchId       String? @map("batch_id") @db.Uuid
  qtyOnHand     Decimal @default(0) @map("qty_on_hand") @db.Decimal(18, 4)
  /// Committed to a pick list or a dispense in progress but not yet moved.
  /// Availability is `qty_on_hand - qty_reserved`.
  qtyReserved   Decimal @default(0) @map("qty_reserved") @db.Decimal(18, 4)
  qtyQuarantined Decimal @default(0) @map("qty_quarantined") @db.Decimal(18, 4)
  qtyInTransitIn Decimal @default(0) @map("qty_in_transit_in") @db.Decimal(18, 4)
  avgCost       Decimal @default(0) @map("avg_cost") @db.Decimal(14, 4)
  value         Decimal @default(0) @db.Decimal(14, 2)
  isConsignment Boolean @default(false) @map("is_consignment")
  lastMovementAt DateTime? @map("last_movement_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([hospitalId, storeId, itemId])
  @@index([hospitalId, itemId, batchId])
  @@index([hospitalId, storeId, qtyOnHand])
  @@map("stock_balances")
  @@schema("inventory")
}

/// FIFO cost layers, for the stores whose `valuation_method` is `fifo`.
/// Consumed oldest-first by the ledger trigger; `qty_remaining` reaching zero
/// closes a layer without deleting it, because a closed layer is what a COGS
/// report is reconstructed from.
model InvFifoLayer {
  id            String  @id @db.Uuid
  hospitalId    String  @map("hospital_id") @db.Uuid
  storeId       String  @map("store_id") @db.Uuid
  itemId        String  @map("item_id") @db.Uuid
  batchId       String? @map("batch_id") @db.Uuid
  receivedAt    DateTime @map("received_at") @db.Timestamptz(6)
  qtyReceived   Decimal @map("qty_received") @db.Decimal(18, 4)
  qtyRemaining  Decimal @map("qty_remaining") @db.Decimal(18, 4)
  unitCost      Decimal @map("unit_cost") @db.Decimal(14, 4)
  sourceLedgerId String? @map("source_ledger_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([hospitalId, storeId, itemId, receivedAt])
  @@map("fifo_layers")
  @@schema("inventory")
}

/// Per-store planning parameters. The reorder engine reads *this*, never the
/// item-level defaults: a ward stocks two boxes of gauze and the main store
/// stocks two hundred, and one reorder level for both is one that is wrong for
/// both.
model InvItemStoreParam {
  id            String  @id @db.Uuid
  hospitalId    String  @map("hospital_id") @db.Uuid
  itemId        String  @map("item_id") @db.Uuid
  storeId       String  @map("store_id") @db.Uuid
  /// All quantities in the item's BASE UoM.
  minQty        Decimal @default(0) @map("min_qty") @db.Decimal(18, 4)
  maxQty        Decimal? @map("max_qty") @db.Decimal(18, 4)
  reorderLevel  Decimal? @map("reorder_level") @db.Decimal(18, 4)
  reorderQty    Decimal? @map("reorder_qty") @db.Decimal(18, 4)
  safetyStock   Decimal? @map("safety_stock") @db.Decimal(18, 4)
  /// True when the safety stock is recomputed from consumption variance rather
  /// than typed. The computed value still lands in `safety_stock`, so the
  /// reorder engine has one column to read.
  safetyAuto    Boolean @default(false) @map("safety_auto")
  parLevel      Decimal? @map("par_level") @db.Decimal(18, 4)
  leadDays      Int?    @map("lead_days")
  reviewDays    Int?    @map("review_days")
  binLocationId String? @map("bin_location_id") @db.Uuid
  autoIndent    Boolean @default(false) @map("auto_indent")
  preferredSourceStoreId String? @map("preferred_source_store_id") @db.Uuid
  isStocked     Boolean @default(true) @map("is_stocked")
  abcClass      InvAbcClass @default(unclassified) @map("abc_class")
  vedClass      InvVedClass @default(unclassified) @map("ved_class")
  fsnClass      InvFsnClass @default(unclassified) @map("fsn_class")
  classifiedAt  DateTime? @map("classified_at") @db.Timestamptz(6)
  lastMovementAt DateTime? @map("last_movement_at") @db.Timestamptz(6)
  deadStockFlag Boolean @default(false) @map("dead_stock_flag")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  item InvItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([itemId, storeId])
  @@index([hospitalId, storeId, isStocked])
  @@index([hospitalId, storeId, autoIndent])
  @@index([hospitalId, deadStockFlag])
  @@map("item_store_params")
  @@schema("inventory")
}
