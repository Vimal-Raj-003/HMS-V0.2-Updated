  changeSetId   String? @map("change_set_id") @db.Uuid
  replacedByKey String? @map("replaced_by_key") @db.Uuid
  approvedBy    String? @map("approved_by") @db.Uuid
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([recordKey, version])
  @@index([hospitalId, branchId, status, effectiveFrom])
  @@index([hospitalId, code])
  @@map("mdm_titles")
  @@schema("mdm")
}

/// The languages this hospital operates in. `CLAUDE.md §4` fixes the superset
/// (`en-IN` plus eleven); a hospital enables a subset, and that subset drives
/// the consent notice language (EN-028), the SMS template language (EN-009) and
/// the TTS announcement rotation on the TV boards (EN-018).
model MdmLanguage {
  id            String  @id @db.Uuid
  recordKey     String  @map("record_key") @db.Uuid
  hospitalId    String  @map("hospital_id") @db.Uuid
  branchId      String? @map("branch_id") @db.Uuid
  version       Int     @default(1)
  code          String  @db.VarChar(16)
  name          String  @db.VarChar(64)
  nativeName    String  @map("native_name") @db.VarChar(64)
  script        String? @db.VarChar(32)
  isRtl         Boolean @default(false) @map("is_rtl")
  ttsVoice      String? @map("tts_voice") @db.VarChar(64)
  usedForPatientComms Boolean @default(true) @map("used_for_patient_comms")
  usedForDisplays Boolean @default(true) @map("used_for_displays")
  sortOrder     Int     @default(0) @map("sort_order")

  effectiveFrom DateTime @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz(6)
  status        MdmRecordStatus @default(draft)
  changeSetId   String? @map("change_set_id") @db.Uuid
  replacedByKey String? @map("replaced_by_key") @db.Uuid
  approvedBy    String? @map("approved_by") @db.Uuid
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([recordKey, version])
  @@index([hospitalId, branchId, status, effectiveFrom])
  @@index([hospitalId, code])
  @@map("mdm_languages")
  @@schema("mdm")
}

model MdmNationality {
  id            String  @id @db.Uuid
  recordKey     String  @map("record_key") @db.Uuid
  hospitalId    String  @map("hospital_id") @db.Uuid
  branchId      String? @map("branch_id") @db.Uuid
  version       Int     @default(1)
  /// ISO 3166-1 alpha-3.
  code          String  @db.Char(3)
  alpha2        String  @db.Char(2)
  name          String  @db.VarChar(120)
  callingCode   String? @map("calling_code") @db.VarChar(8)
  /// A foreign national triggers passport/visa capture and, at a forex counter,
  /// the FEMA encashment certificate (NC-001 §5).
  requiresPassport Boolean @default(false) @map("requires_passport")
  sortOrder     Int     @default(0) @map("sort_order")

  effectiveFrom DateTime @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz(6)
  status        MdmRecordStatus @default(draft)
  changeSetId   String? @map("change_set_id") @db.Uuid
  replacedByKey String? @map("replaced_by_key") @db.Uuid
  approvedBy    String? @map("approved_by") @db.Uuid
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([recordKey, version])
  @@index([hospitalId, branchId, status, effectiveFrom])
  @@index([hospitalId, code])
  @@map("mdm_nationalities")
  @@schema("mdm")
}

/// OP-001 §3.1: "Referral source (self/doctor/camp/website)". A master because
/// marketing (NC-026) reports conversion by source and invents new ones.
model MdmReferralSource {
  id            String  @id @db.Uuid
  recordKey     String  @map("record_key") @db.Uuid
  hospitalId    String  @map("hospital_id") @db.Uuid
  branchId      String? @map("branch_id") @db.Uuid
