{
  "name": "@vims/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Single source of truth shared by web, API, workers and mobile: Zod schemas, permission catalogue, role templates, domain events, entitlement keys, Money and Id primitives.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./permissions": "./src/rbac/permissions.ts",
    "./roles": "./src/rbac/role-templates.ts",
    "./events": "./src/events/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./primitives": "./src/primitives/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0 --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "uuidv7": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "^4.1.1",
    "vitest": "^4.1.10"
  }
}
