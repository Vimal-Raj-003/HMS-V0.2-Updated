{
  "name": "@vims/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Single source of truth shared by web, API, workers and mobile: Zod schemas, permission catalogue, role templates, domain events, entitlement keys, Money and Id primitives.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./permissions": {
      "development": "./src/rbac/permissions.ts",
      "types": "./dist/rbac/permissions.d.ts",
      "import": "./dist/rbac/permissions.js",
      "default": "./dist/rbac/permissions.js"
    },
    "./roles": {
      "development": "./src/rbac/role-templates.ts",
      "types": "./dist/rbac/role-templates.d.ts",
      "import": "./dist/rbac/role-templates.js",
      "default": "./dist/rbac/role-templates.js"
    },
    "./events": {
      "development": "./src/events/index.ts",
      "types": "./dist/events/index.d.ts",
      "import": "./dist/events/index.js",
      "default": "./dist/events/index.js"
    },
    "./schemas": {
      "development": "./src/schemas/index.ts",
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js",
      "default": "./dist/schemas/index.js"
    },
    "./primitives": {
      "development": "./src/primitives/index.ts",
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js",
      "default": "./dist/primitives/index.js"
    },
    "./scores": {
      "development": "./src/scores/index.ts",
      "types": "./dist/scores/index.d.ts",
      "import": "./dist/scores/index.js",
      "default": "./dist/scores/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src --max-warnings=0 --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "uuidv7": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "^4.1.1",
    "vitest": "^4.1.10"
  }
}
