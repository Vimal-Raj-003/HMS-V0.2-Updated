{
  "name": "@vims/i18n",
  "version": "0.1.0",
  "private": true,
  "description": "next-intl message catalogues. en-IN default plus hi, ta, te, ml, kn, mr, bn, gu, or, pa and ar (RTL) — the locale superset fixed by DECISIONS D-13.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./messages/*": "./src/messages/*.json"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0 --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage:check": "tsx src/check-coverage.ts"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "vitest": "^4.1.10"
  }
}
