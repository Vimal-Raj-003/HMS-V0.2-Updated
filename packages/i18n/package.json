{
  "name": "@vims/i18n",
  "version": "0.1.0",
  "private": true,
  "description": "next-intl message catalogues. en-IN default plus hi, ta, te, ml, kn, mr, bn, gu, or, pa and ar (RTL) \u2014 the locale superset fixed by DECISIONS D-13.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./messages/*": "./src/messages/*.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/messages','dist/messages',{recursive:true})\"",
    "lint": "eslint src --max-warnings=0 --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage:check": "tsx src/check-coverage.ts"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "vitest": "^4.1.10"
  }
}
