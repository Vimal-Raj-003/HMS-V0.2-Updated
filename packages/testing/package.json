{
  "name": "@vims/testing",
  "version": "0.1.0",
  "private": true,
  "description": "Testcontainers harness, factories, and the synthetic Indian patient generator. No production PHI ever reaches a lower environment (docs/09 §11).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./containers": "./src/containers/index.ts",
