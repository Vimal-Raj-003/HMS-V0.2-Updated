{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", ".env"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DATABASE_URL_RO",
    "DATABASE_MIGRATE_URL",
    "REDIS_URL",
    "S3_ENDPOINT",
    "S3_BUCKET",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "JWT_PRIVATE_KEY",
    "JWT_PUBLIC_KEY",
    "LICENCE_PUBLIC_KEY",
    "SMTP_URL",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_REALTIME_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "generated/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "test:safety": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "generate": {
      "cache": false,
      "outputs": ["generated/**", "node_modules/.prisma/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
