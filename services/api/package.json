{
  "name": "@vims/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS 11 modular monolith on Fastify. /api/v1 with the full tenancy, policy, idempotency, audit and outbox interceptor chain.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "dotenv -e ../../.env -v PORT=4000 -- nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src --max-warnings=0 --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:safety": "vitest run --config vitest.safety.config.ts",
    "openapi:generate": "tsx src/tooling/generate-openapi.ts",
    "keys:generate": "tsx src/tooling/generate-keys.ts",
    "keys:vapid": "tsx src/tooling/generate-vapid.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-fastify": "^11.2.1",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.0.0",
    "@opentelemetry/auto-instrumentations-node": "^0.56.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@prisma/client": "6.19.3",
    "@vims/contracts": "workspace:*",
    "@vims/db": "workspace:*",
    "argon2": "^0.45.1",
    "bullmq": "^6.1.2",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "jose": "^6.0.11",
    "nestjs-pino": "^4.6.1",
    "otplib": "^13.4.1",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuidv7": "^1.2.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3",
    "zod-openapi": "^6.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.2.1",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "@vims/testing": "workspace:*",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv-cli": "^8.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^4.1.10"
  },
  "type": "module"
}
