{
  "name": "@vims/worker",
  "version": "0.1.0",
  "private": true,
  "description": "BullMQ processors and cron: outbox relay, escalation timers, partition maintenance, retention/archival, PDF rendering, print dispatch.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "dotenv -e ../../.env -v PORT=3003 -- tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src --max-warnings=0 --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@vims/contracts": "workspace:*",
    "@vims/db": "workspace:*",
    "@vims/print-templates": "workspace:*",
    "bullmq": "^6.1.2",
    "ioredis": "^6.0.0",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "playwright": "^1.62.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@vims/testing": "workspace:*",
    "dotenv-cli": "^8.0.0",
    "tsx": "^4.19.2",
    "vitest": "^4.1.10"
  }
}
