# ─────────────────────────────────────────────────────────────────────────────
# Vim's HMS — environment template
#
#   cp infra/env.example .env
#
# NEVER commit `.env` (see .gitignore). Production and on-prem secrets come from
# Vault / AWS SSM / Azure Key Vault, never from a file in the repo (docs/10 §9).
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
TZ=UTC

# ── Database (PostgreSQL 17) ─────────────────────────────────────────────────
# Three roles with different privileges (docs/04 §6 "least-privilege DB roles"):
#   hms_app       — no DDL, RLS ENFORCED (NOBYPASSRLS). All services use this.
#   hms_migrator  — owns the schema, may DDL. Used ONLY by `prisma migrate`.
#   hms_readonly  — SELECT only, for analytics/reports on the replica.
DATABASE_URL="postgresql://hms_app:hms_app_dev@localhost:5433/vims_hms?schema=public&connection_limit=12&pool_timeout=10"
DATABASE_URL_RO="postgresql://hms_readonly:hms_readonly_dev@localhost:5433/vims_hms?schema=public&connection_limit=6"
DATABASE_MIGRATE_URL="postgresql://hms_migrator:hms_migrator_dev@localhost:5433/vims_hms?schema=public"

# ── Redis 7 / Valkey (sessions, rate limits, BullMQ queues, hot caches) ──────
REDIS_URL="redis://localhost:6380"

# ── Object storage (MinIO locally, S3 in cloud) ──────────────────────────────
S3_ENDPOINT="http://localhost:9100"
S3_REGION="us-east-1"
S3_BUCKET="vims-hms-dev"
S3_ACCESS_KEY="vimsminio"
S3_SECRET_KEY="vimsminio_dev_secret"
S3_FORCE_PATH_STYLE=true
# docs/04 §4: presigned URLs must expire within 5 minutes
S3_PRESIGN_TTL_SECONDS=300

# ── Auth (EN-007 / EN-025) ───────────────────────────────────────────────────
# What the code reads TODAY: `services/api/src/core/config/env.ts` and
# `services/realtime/src/config/env.ts` require two symmetric HS256 secrets of
# at least 32 characters, and `infra/docker/docker-compose.onprem.yml` passes
# exactly these two names. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
#
# DEVIATION, tracked: EN-007 §Security specifies "JWT RS256/EdDSA 15 min", i.e.
# asymmetric signing, so that a verifier such as `services/realtime` holds a
# public key and cannot mint tokens. The keypair below and the
# `pnpm --filter @vims/api keys:generate` script exist for that design; nothing
# reads them yet. Until the switch is made, the access secret is shared with
# every service that verifies a token.
# Ed25519 keypair for access-token signing (base64 PKCS#8 / SPKI DER).
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_ISSUER="vims-hms"
JWT_AUDIENCE="vims-hms-api"
# docs/04 §2: access 15 min, absolute session 12 h
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=43200
COOKIE_DOMAIN="localhost"
COOKIE_SECURE=false

# Argon2id (docs/04 §2: memory >= 64 MB, t=3)
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Column encryption for Aadhaar-last-4 / ABHA tokens / bank / biometric
# (docs/04 §4). 32 bytes base64. Production: KMS/Vault, never env.
COLUMN_ENCRYPTION_KEY=""

# ── Licence (EN-040) ─────────────────────────────────────────────────────────
# PUBLIC key only — compiled in so on-prem validation works fully offline.
LICENCE_PUBLIC_KEY=""
LICENCE_KEY_PATH="./infra/licence/dev.lic"

# ── Email (EN-032) — Mailpit locally, SES/SMTP in production ─────────────────
SMTP_URL="smtp://localhost:1026"
SMTP_FROM="Vim's HMS <no-reply@vimshms.local>"

# ── Web Push (EN-037) ────────────────────────────────────────────────────────
#   pnpm --filter @vims/api keys:vapid
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:it@vimshms.local"

# ── Service ports ────────────────────────────────────────────────────────────
API_PORT=4000
REALTIME_PORT=4001
INTEGRATION_HUB_PORT=4002
INTEGRATION_HUB_MLLP_PORT=2575
WEB_PORT=3000
TV_KIOSK_PORT=3001

# ── Frontend (public — must contain no secrets and no PHI) ───────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_REALTIME_URL="http://localhost:4001"
NEXT_PUBLIC_APP_VERSION="0.1.0-dev"
NEXT_PUBLIC_DEFAULT_LOCALE="en-IN"

# ── Observability (docs/07 §8) — no PHI in any log, metric or trace ──────────
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_SERVICE_NAME="vims-hms"
LOG_LEVEL="debug"
SENTRY_DSN=""

# ── Rate limits (docs/04 §6) ─────────────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_OTP_PER_HOUR=5
RATE_LIMIT_API_PER_MINUTE=600

# ── Dev seed password (development only — CI asserts it is never in prod) ────
DEV_SEED_PASSWORD="VimsHms#Dev2026"
